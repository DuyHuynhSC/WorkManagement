<Window x:Class="WorkManagement.Views.SelectTesterImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chọn Người Kiểm Tra Cần Import"
        Height="600" Width="550" MinHeight="450" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBannerStyle}" Padding="16,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountFilterOutline" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lọc Người Kiểm Tra Cần Import" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtSubtitle" Text="Chọn các người kiểm tra mà bạn muốn nạp dữ liệu" FontSize="11" Opacity="0.85"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtHeaderBadge" Text="0 người" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppHeaderForegroundBrush}"/>
            </DockPanel>
        </Border>

        <!-- QUICK ACTIONS & SEARCH BAR -->
        <Border Grid.Row="1" Style="{StaticResource AppSubtleToolbarBorderStyle}" Margin="14,10,14,6" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <Border Grid.Row="0" Background="{DynamicResource AppCardBackgroundBrush}"
                        BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Grid.Column="0"
                                                 Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtSearchTester" Grid.Column="1"
                                 materialDesign:HintAssist.Hint="Tìm nhanh tên người kiểm tra..."
                                 Foreground="{DynamicResource AppPrimaryTextBrush}"
                                 BorderThickness="0" VerticalAlignment="Center" FontSize="12"
                                 TextChanged="TxtSearchTester_TextChanged"/>
                        <Button x:Name="BtnClearSearch" Grid.Column="2" Style="{StaticResource MaterialDesignFlatButton}"
                                Width="24" Height="24" Padding="0"
                                Visibility="Collapsed" Click="BtnClearSearch_Click">
                            <materialDesign:PackIcon Kind="CloseCircle" Width="14" Height="14"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Select All / Deselect All Buttons -->
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AppOutlinedButtonStyle}" Height="28" Padding="10,0" Margin="0,0,8,0"
                                Click="BtnSelectAll_Click" ToolTip="Chọn tất cả người kiểm tra">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Chọn Tất Cả" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppOutlinedButtonStyle}" Height="28" Padding="10,0"
                                Click="BtnDeselectAll_Click" ToolTip="Bỏ chọn tất cả">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckboxBlankCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Bỏ Chọn Tất Cả" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="TxtSelectionStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryTextBrush}"
                               Text="Đã chọn: 0/0"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- TESTER LIST -->
        <materialDesign:Card Grid.Row="2" Margin="14,4,14,10" Padding="6">
            <ListBox x:Name="ListTesters" SelectionMode="Single"
                     Background="{DynamicResource AppCardBackgroundBrush}"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Click="TesterCheckBox_Click"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                            </StackPanel>

                            <!-- Badge số lượng máy -->
                            <Border Grid.Column="2" Background="{DynamicResource AppBadgeBackgroundBrush}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountBadgeText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource AppBadgeForegroundBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </materialDesign:Card>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="3" Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="TxtFooterHelp" Text="Chỉ những máy thuộc người kiểm tra được chọn mới được import."
                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Height="34" Width="90" Margin="0,0,8,0" Click="BtnCancel_Click" Content="Hủy"/>
                    <Button x:Name="BtnConfirm" Style="{StaticResource AppSuccessButtonStyle}"
                            Height="34" Padding="16,0" Click="BtnConfirm_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckBold" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Áp Dụng Lọc &amp; Xem Trước" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>