<UserControl x:Class="WorkManagement.Views.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10,14,14">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- HEADER BANNER -->
            <Border Margin="0,0,0,14" Padding="16,12" Style="{StaticResource AppHeaderBannerStyle}" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <materialDesign:PackIcon Kind="RobotOutline" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CẤU HÌNH AI MODEL NỘI BỘ (OPENAI-COMPATIBLE)" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Kết nối trực tiếp server AI nội bộ (Bỏ qua Proxy doanh nghiệp), hỗ trợ tự động tải danh sách Model có sẵn"
                                   FontSize="11.5" Opacity="0.9"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN SETTINGS CARD -->
            <materialDesign:Card Margin="0,0,0,14" Padding="18,14"
                                 Background="{DynamicResource AppCardBackgroundBrush}"
                                 BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <!-- Toggle Enable AI -->
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="20" Height="20" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="1. Trạng Thái &amp; Thông Tin Kết Nối" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkAiEnabled" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                  Content="Kích hoạt tính năng AI (Schema Mapping, SQL Generator, Cố vấn Database)"
                                  FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"/>
                    </DockPanel>

                    <Grid IsEnabled="{Binding ElementName=ChkAiEnabled, Path=IsChecked}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- BaseUrl -->
                            <RowDefinition Height="Auto"/> <!-- ApiKey & Bypass Proxy -->
                            <RowDefinition Height="Auto"/> <!-- Model Fetch & Selection -->
                            <RowDefinition Height="Auto"/> <!-- Advanced Settings -->
                        </Grid.RowDefinitions>

                        <!-- ROW 0: Base URL -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Endpoint URL (Chuẩn OpenAI API):" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{DynamicResource AppPrimaryTextBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtBaseUrl"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="Ví dụ: http://10.x.x.x:8000/v1 hoặc http://ai.company.vn/v1 hoặc http://localhost:11434/v1"
                                     ToolTip="URL gốc tương thích OpenAI, hệ thống sẽ tự động gọi /v1/models và /v1/chat/completions"
                                     FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- ROW 1: API Key & Bypass Proxy Checkbox -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- API Key -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="API Key / Token xác thực (Tùy chọn):" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="TxtApiKey" Grid.Column="0"
                                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                                 materialDesign:HintAssist.Hint="Bearer Token (Tự động mã hóa an toàn bằng Windows DPAPI)"
                                                 FontSize="12" VerticalContentAlignment="Center"/>
                                    <TextBox x:Name="TxtApiKeyRevealed" Grid.Column="0" Visibility="Collapsed"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             materialDesign:HintAssist.Hint="Bearer Token (Tự động mã hóa an toàn bằng Windows DPAPI)"
                                             FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnToggleApiKey" Grid.Column="1"
                                            Style="{StaticResource MaterialDesignToolForegroundButton}"
                                            Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                                            VerticalAlignment="Center" Click="BtnToggleApiKey_Click"
                                            ToolTip="Ẩn / Hiện API Key">
                                        <materialDesign:PackIcon x:Name="IconApiKeyEye" Kind="EyeOutline" Width="18" Height="18"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Checkbox Bỏ qua Proxy công ty -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,16,0,0">
                                <CheckBox x:Name="ChkBypassProxy" IsChecked="True"
                                          Content="Bỏ qua Proxy công ty (Kết nối trực tiếp Intranet)"
                                          FontWeight="Bold" Foreground="{DynamicResource AppPrimaryButtonBackground}"
                                          ToolTip="Ép buộc HttpClient không định tuyến qua Corporate Proxy để gọi trực tiếp AI Model trong mạng nội bộ"
                                          Cursor="Hand"/>
                                <TextBlock Text="* Khuyến nghị luôn bật đối với các máy chủ AI nội bộ" FontSize="10.5"
                                           Foreground="{DynamicResource AppSecondaryTextBrush}" Opacity="0.8" Margin="24,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ROW 2: MODEL SELECTION & FETCH BUTTON -->
                        <Border Grid.Row="2" Margin="0,0,0,16" Padding="14,12"
                                Background="{DynamicResource AppSecondarySubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ServerNetwork" Width="18" Height="18" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource AppSectionIconBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="2. Danh Sách Model Có Sẵn (Auto-Discovery)" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Status Message -->
                                    <TextBlock x:Name="TxtStatusMessage" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               Text="Nhấn 'Kiểm Tra &amp; Tải Model' để tải danh sách từ server"
                                               FontSize="11.5" Foreground="{DynamicResource AppSecondaryTextBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nút Test & Tải Model -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Button x:Name="BtnTestAndLoadModels" Style="{StaticResource AppPrimaryButtonStyle}"
                                                Height="36" Padding="14,0" Click="BtnTestAndLoadModels_Click"
                                                ToolTip="Gửi request kiểm tra kết nối và truy vấn danh sách model đang chạy từ server (/v1/models)">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CloudSyncOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="TxtTestBtnLabel" Text="Kiểm Tra &amp; Tải Model" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar x:Name="BusyBarModels" IsIndeterminate="True" Width="50" Height="4"
                                                     Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- ComboBox Model Selection -->
                                    <ComboBox x:Name="CboModelName" Grid.Column="1" IsEditable="True"
                                              VerticalContentAlignment="Center"
                                              materialDesign:HintAssist.Hint="Chọn hoặc nhập tên Model (VD: qwen2.5-coder, llama-3.3...)"
                                              ToolTip="Chọn model từ danh sách server trả về, hoặc gõ trực tiếp tên model tùy chỉnh"
                                              FontSize="12" FontFamily="Consolas" MinHeight="36"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ROW 3: ADVANCED PARAMETERS -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="3. Tham Số Nâng Cao (Tùy chọn):" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{DynamicResource AppPrimaryTextBrush}" Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtTimeout" Grid.Column="0" Margin="0,0,12,0"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         materialDesign:HintAssist.Hint="Timeout (Giây)"
                                         Text="30" VerticalContentAlignment="Center" FontSize="12"/>

                                <TextBox x:Name="TxtTemperature" Grid.Column="1" Margin="0,0,12,0"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         materialDesign:HintAssist.Hint="Temperature (0.0 - 1.0)"
                                         Text="0.1" ToolTip="Giá trị thấp (0.0 - 0.2) giúp model trả về kết quả cấu trúc và code chính xác nhất"
                                         VerticalContentAlignment="Center" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- FOOTER ACTION BUTTONS -->
            <Border Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,12" CornerRadius="6">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="* Mật khẩu/API Key được bảo vệ chuẩn DPAPI Windows CurrentUser"
                               VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" Opacity="0.8"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnSaveSettings" Style="{StaticResource AppPrimaryButtonStyle}"
                                Height="36" Padding="20,0" Click="BtnSaveSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheckOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Lưu Cấu Hình AI" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
