<Window x:Class="WorkManagement.Views.SelectUsersToDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Xác Nhận Danh Sách User Oracle Cần Xóa"
        Height="540" Width="720" MinHeight="420" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/WorkManagement;component/Assets/app.ico"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Project Info Card -->
            <RowDefinition Height="Auto"/> <!-- Quick Tools -->
            <RowDefinition Height="*"/>    <!-- Users Grid -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" Background="{DynamicResource AppDangerButtonBackground}" CornerRadius="6">
            <DockPanel LastChildFill="True">
                <materialDesign:PackIcon Kind="AccountAlertOutline" Width="28" Height="28"
                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="XÁC NHẬN DANH SÁCH ORACLE USER CẦN XÓA" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Đánh dấu chính xác các user bạn muốn xóa. Các user không được chọn sẽ được BẢO TOÀN NGUYÊN VẸN."
                               FontSize="11" Foreground="White" Opacity="0.95"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: INFO SUMMARY -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,10" Padding="12,8"
                             Background="{DynamicResource AppCardBackgroundBrush}"
                             BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="DatabaseOutline" Width="18" Height="18"
                                         Foreground="{DynamicResource AppPrimaryButtonBackground}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtDbSummary" Text="Dự án: ... | Server: ... "
                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- ROW 2: TOOLBAR CHỌN NHANH -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Style="{StaticResource AppOutlinedButtonStyle}" Height="28" Padding="8,0" Margin="0,0,6,0" Click="BtnSelectAll_Click" ToolTip="Chọn xóa tất cả">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckboxMultipleMarkedOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Xóa tất cả" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AppOutlinedButtonStyle}" Height="28" Padding="8,0" Margin="0,0,10,0" Click="BtnUnselectAll_Click" ToolTip="Bỏ chọn xóa tất cả">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckboxMultipleBlankOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Bỏ chọn xóa" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Separator Margin="0,2,10,2" Background="{DynamicResource AppSubtlePanelBorderBrush}"/>

                <Button Style="{StaticResource AppOutlinedButtonStyle}" Height="28" Padding="8,0" Margin="0,0,6,0" Click="BtnBackupAll_Click" ToolTip="Chọn sao lưu tất cả">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource AppPrimaryButtonBackground}"/>
                        <TextBlock Text="Sao lưu tất cả" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AppOutlinedButtonStyle}" Height="28" Padding="8,0" Click="BtnUnbackupAll_Click" ToolTip="Bỏ chọn sao lưu tất cả">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudOffOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Bỏ sao lưu" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="TxtSelectionCount" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="Xóa: 0 | Sao lưu: 0" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AppPrimaryButtonBackground}"/>
        </DockPanel>

        <!-- ROW 3: USER LIST -->
        <materialDesign:Card Grid.Row="3" Margin="0,0,0,12" Padding="6"
                             Background="{DynamicResource AppCardBackgroundBrush}"
                             BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="1">
            <DataGrid x:Name="GridUsers" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      materialDesign:DataGridAssist.CellPadding="8,6"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Xóa" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                    <DataGridCheckBoxColumn Header="Sao Lưu" Binding="{Binding IsBackupSelected, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                    <DataGridTextColumn Header="Oracle Username" Binding="{Binding UserName}" Width="190"
                                        FontFamily="Consolas" FontWeight="Bold" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Dự án" Binding="{Binding ProjectName}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Database Server" Binding="{Binding HostServer}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- ROW 4: FOOTER ACTIONS -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Cảnh báo: User bị xóa sẽ chạy kèm mệnh đề CASCADE (toàn bộ dữ liệu schema sẽ mất)."
                       FontSize="11" Foreground="{DynamicResource AppDangerButtonBackground}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppOutlinedButtonStyle}"
                        Height="34" Padding="16,0" Margin="0,0,10,0" IsCancel="True" Content="Hủy Bỏ"/>

                <Button x:Name="BtnConfirm" Style="{StaticResource AppDangerButtonStyle}"
                        Height="34" Padding="18,0" Click="BtnConfirm_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteForeverOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xác Nhận Xóa User Đã Chọn" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>