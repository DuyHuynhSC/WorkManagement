<Window x:Class="WorkManagement.Views.EmailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkManagement.Views"
        Title="Cấu hình Gửi Email Báo Cáo Xem Trước" Height="570" Width="670"
        MinHeight="520" MinWidth="580"
        Icon="pack://application:,,,/WorkManagement;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBannerStyle}" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="EmailFastOutline" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cấu hình Gửi Email Kết Quả Xem Trước" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Thiết lập Outgoing Server (SMTP - Port 25/587) và danh sách email thành viên nhận báo cáo (áp dụng chung cho tất cả Profile)"
                               FontSize="11" Opacity="0.85" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Embedded Reusable View -->
        <views:EmailSettingsView x:Name="InnerView" Grid.Row="1"/>
    </Grid>
</Window>
