<Window x:Class="WorkManagement.Views.OracleScriptGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Trợ Lý Sinh Script Oracle Database AI"
        Height="720" Width="950" MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Project Context & Preset Scenario -->
            <RowDefinition Height="*"/>    <!-- Generated SQL Code & Explanation -->
            <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER BANNER -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" Style="{StaticResource AppHeaderBannerStyle}" CornerRadius="6">
            <DockPanel LastChildFill="True">
                <materialDesign:PackIcon Kind="DatabaseCogOutline" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI CỐ VẤN &amp; SINH SCRIPT ORACLE DATABASE" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Sinh mã Oracle SQL / PL*SQL / Data Pump chuẩn xác, có kèm chú thích an toàn và kiểm tra rủi ro"
                               FontSize="11.5" Opacity="0.9"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: CONTEXT & PROMPT SETTINGS -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,10" Padding="14,10"
                             Background="{DynamicResource AppCardBackgroundBrush}"
                             BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="1">
            <StackPanel>
                <!-- Dự án ngữ cảnh & Kịch bản mẫu -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chọn dự án -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Dự án ngữ cảnh:" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppPrimaryTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboProjects" Height="36"
                                  VerticalContentAlignment="Center"
                                  Foreground="{DynamicResource AppPrimaryTextBrush}"
                                  Background="{DynamicResource AppCardBackgroundBrush}"
                                  BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                                  BorderThickness="1"
                                  FontSize="12"
                                  SelectionChanged="CboProjects_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProjectName}"
                                               Foreground="{DynamicResource AppPrimaryTextBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Chọn kịch bản mẫu -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Kịch bản mẫu nhanh (Templates):" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppPrimaryTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CboPresets" Height="36"
                                  VerticalContentAlignment="Center"
                                  Foreground="{DynamicResource AppPrimaryTextBrush}"
                                  Background="{DynamicResource AppCardBackgroundBrush}"
                                  BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                                  BorderThickness="1"
                                  FontSize="12"
                                  SelectedIndex="0"
                                  SelectionChanged="CboPresets_SelectionChanged">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="1. Dọn dẹp: Kill Active Sessions + DROP USER CASCADE + DROP TABLESPACE"/>
                            <ComboBoxItem Content="2. Giám sát: Kiểm tra dung lượng Tablespace, Datafiles &amp; Free Space"/>
                            <ComboBoxItem Content="3. Sao lưu: Lệnh xuất dữ liệu Oracle Data Pump (expdp) theo Schemas"/>
                            <ComboBoxItem Content="4. Bảo trì: Kiểm tra Invalid Objects và Recompile Packages/Views"/>
                            <ComboBoxItem Content="5. Tùy chỉnh: Nhập yêu cầu bằng ngôn ngữ tự nhiên bên dưới..."/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Thông tin tóm tắt Schema ngữ cảnh -->
                <Border Background="{DynamicResource AppSecondarySubtleBackgroundBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtContextSummary" Text="Host: ... | Service: ... | Users: ... | Tablespace: ..."
                               FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                </Border>

                <!-- Input Prompt tùy biến -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtCustomPrompt" Grid.Column="0" Margin="0,0,10,0"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="Yêu cầu cụ thể (ngôn ngữ tự nhiên hoặc sửa đổi template)..."
                             Text="Viết script hoàn chỉnh để ngắt các kết nối active, xóa DB Users và xóa Tablespace của dự án này."
                             Foreground="{DynamicResource AppPrimaryTextBrush}"
                             VerticalContentAlignment="Center" FontSize="12"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="BtnGenerate" Style="{StaticResource AppPrimaryButtonStyle}"
                                Height="36" Padding="14,0" Click="BtnGenerate_Click"
                                ToolTip="Gọi AI Model nội bộ để sinh script">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtGenerateLabel" Text="Sinh Script Bằng AI" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ProgressBar x:Name="BusyBarGenerate" IsIndeterminate="True" Width="40" Height="4"
                                     Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- ROW 2: GENERATED SQL SCRIPT & EXPLANATION (TABBED VIEW) -->
        <materialDesign:Card Grid.Row="2" Margin="0,0,0,10" Padding="12,10"
                             Background="{DynamicResource AppCardBackgroundBrush}"
                             BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Segmented Tabs & Action Buttons -->
                    <RowDefinition Height="*"/>    <!-- Active Tab Content -->
                </Grid.RowDefinitions>

                <!-- Row 0: Navigation Header & Action Buttons -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- Segmented Tab Switcher (Left) -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnTabSql" Style="{StaticResource AppPrimaryButtonStyle}"
                                Height="30" Padding="12,0" Margin="0,0,6,0" Click="BtnTabSql_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CodeBraces" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Mã Lệnh Oracle SQL" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnTabAdvice" Style="{StaticResource AppOutlinedButtonStyle}"
                                Height="30" Padding="12,0" Click="BtnTabAdvice_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Hướng Dẫn &amp; Cảnh Báo An Toàn" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <Border x:Name="BadgeAdviceCount" Background="#DC2626" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="AI" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Action Buttons for Tab 1 (Right) -->
                    <StackPanel x:Name="PanelSqlActions" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="BtnCopySqlOnly" Style="{StaticResource AppOutlinedButtonStyle}"
                                Height="28" Padding="10,0" Margin="0,0,6,0" Click="BtnCopySqlOnly_Click"
                                ToolTip="Chỉ sao chép các câu lệnh SQL vào Clipboard (bỏ qua lời giải thích)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CodeTags" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Chép Lệnh SQL" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnCopyScript" Style="{StaticResource AppOutlinedButtonStyle}"
                                Height="28" Padding="10,0" Margin="0,0,6,0" Click="BtnCopyScript_Click"
                                ToolTip="Sao chép toàn bộ nội dung mã và chú thích vào Clipboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Sao Chép Tất Cả" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSaveScript" Style="{StaticResource AppOutlinedButtonStyle}"
                                Height="28" Padding="10,0" Click="BtnSaveScript_Click"
                                ToolTip="Lưu script ra file .sql trên máy">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDownloadOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Lưu File .sql" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Action Buttons for Tab 2 (Right) -->
                    <StackPanel x:Name="PanelAdviceActions" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button x:Name="BtnCopyAdvice" Style="{StaticResource AppOutlinedButtonStyle}"
                                Height="28" Padding="10,0" Click="BtnCopyAdvice_Click"
                                ToolTip="Sao chép toàn bộ nội dung hướng dẫn DBA">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Sao Chép Hướng Dẫn" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- TAB 1: SQL SCRIPT TERMINAL VIEWER -->
                <Grid x:Name="GridTabSql" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Full-size Dark Terminal Editor -->
                    <Border Grid.Row="0" Style="{StaticResource AppTerminalBorderStyle}" Padding="8">
                        <RichTextBox x:Name="RtbGeneratedScript"
                                     Style="{x:Null}"
                                     IsReadOnly="False"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource AppTerminalForegroundBrush}"
                                     CaretBrush="{DynamicResource AppAccentHighlightBrush}"
                                     FontFamily="Consolas, 'Cascadia Code', 'Courier New', monospace"
                                     FontSize="12.5"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto">
                            <FlowDocument PageWidth="2500" TextAlignment="Left">
                                <Paragraph Margin="0">
                                    <Run Text="-- Nhấn 'Sinh Script Bằng AI' để tạo mã lệnh Oracle tương ứng..."/>
                                </Paragraph>
                            </FlowDocument>
                        </RichTextBox>
                    </Border>

                    <!-- Bottom Quick Notice with Link to Tab 2 -->
                    <Border Grid.Row="1" Background="{DynamicResource AppSecondarySubtleBackgroundBrush}"
                            CornerRadius="4" Padding="10,6" Margin="0,6,0,0">
                        <DockPanel LastChildFill="True">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    DockPanel.Dock="Right" Padding="8,0" Height="24"
                                    Click="BtnTabAdvice_Click" ToolTip="Mở tab hướng dẫn &amp; cảnh báo an toàn">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Xem hướng dẫn chi tiết &amp; cảnh báo" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AppAccentHighlightBrush}"/>
                                    <materialDesign:PackIcon Kind="ArrowRight" Width="12" Height="12" VerticalAlignment="Center" Margin="4,0,0,0"
                                                             Foreground="{DynamicResource AppAccentHighlightBrush}"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="14" Height="14"
                                                         Foreground="#EAB308" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtQuickNote" Text="Khuyến nghị: Luôn kiểm tra kỹ các câu lệnh DROP và đảm bảo đã có bản sao lưu trước khi thực thi."
                                           FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- TAB 2: GUIDANCE & SAFETY ADVISOR -->
                <Grid x:Name="GridTabAdvice" Grid.Row="1" Visibility="Collapsed">
                    <Border Background="{DynamicResource AppSecondarySubtleBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtlePanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox x:Name="TxtExplanation" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource AppPrimaryTextBrush}"
                                     FontSize="12.5"
                                     FontFamily="Consolas, 'Segoe UI', sans-serif"
                                     TextWrapping="Wrap"
                                     Text="Chưa có hướng dẫn hoặc cảnh báo từ AI. Nhấn 'Sinh Script Bằng AI' để nhận phân tích chi tiết."/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- ROW 3: FOOTER -->
        <Border Grid.Row="3" Padding="0,4,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="* Kết nối AI nội bộ được định tuyến trực tiếp (Bỏ qua Proxy doanh nghiệp)"
                           VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppSecondaryTextBrush}" Opacity="0.8"/>
                <Button x:Name="BtnClose" Style="{StaticResource AppOutlinedButtonStyle}"
                        Height="34" Padding="18,0" HorizontalAlignment="Right"
                        Content="Đóng" Click="BtnClose_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
