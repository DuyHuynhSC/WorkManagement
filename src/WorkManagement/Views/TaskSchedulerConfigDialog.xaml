<Window x:Class="WorkManagement.Views.TaskSchedulerConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:WorkManagement.Views"
        Title="Cấu Hình Windows Task Scheduler"
        Height="560" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource AppHeaderBannerStyle}" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CalendarClock" Width="28" Height="28"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cấu Hình Lịch Chạy Windows Task Scheduler" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Tự động quét, backup và dọn dẹp file FTP định kỳ ở chế độ Console ngầm" FontSize="11" Opacity="0.85"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Embedded Reusable View -->
        <views:TaskSchedulerView x:Name="InnerView" Grid.Row="1"/>

        <!-- FOOTER -->
        <Border Grid.Row="2" Style="{StaticResource AppDialogFooterBorderStyle}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppOutlinedButtonStyle}"
                        Height="34" Width="90" IsCancel="True" Click="BtnClose_Click"
                        Content="Đóng"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
